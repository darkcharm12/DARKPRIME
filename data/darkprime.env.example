# Copy this file to data/darkprime.env and edit before production use.
# scripts/setup_kali.sh creates a populated file with random values automatically.
export DARKPRIME_SECRET_KEY="replace-with-a-long-random-value"
export DARKPRIME_TOKEN_PEPPER="replace-with-a-different-long-random-value"
export DARKPRIME_DATA_DIR="$(pwd)/data"
export DARKPRIME_DATABASE="$(pwd)/data/darkprime.sqlite3"

# Production hardening (use only with a valid trusted TLS certificate):
# export DARKPRIME_REQUIRE_HTTPS=1
# export DARKPRIME_COOKIE_SECURE=1
# export DARKPRIME_POLL_INTERVAL=900

# Optional operator bootstrap (otherwise scripts/setup_kali.sh prompts):
# export DARKPRIME_ADMIN_USER="operator"
# export DARKPRIME_ADMIN_PASS="a-long-random-password"
