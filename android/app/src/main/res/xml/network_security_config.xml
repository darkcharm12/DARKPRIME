<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All traffic must use TLS. The bundled DARKPRIME lab CA allows the app to
         trust the server certificate generated for this deployment. Replace it with a
         publicly trusted certificate for production. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/darkprime_lab_ca" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/darkprime_lab_ca" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
